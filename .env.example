# -------------------------------------------------------------
# AI Voiceover SaaS Monorepo Environment Variables
# -------------------------------------------------------------

# PostgreSQL Database Connection (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voicex_saas?schema=public"

# NextAuth.js Authentication
NEXTAUTH_SECRET="your-super-secret-random-32-character-auth-secret-string"
NEXTAUTH_URL="http://localhost:3000"

# Redis Connection (BullMQ Queue)
REDIS_URL="redis://127.0.0.1:6379"

# Fish Audio API Key (Server-side only)
FISH_AUDIO_API_KEY="your_fish_audio_api_key_here"

# AWS S3 / Object Storage (for synthesized audio files)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_S3_BUCKET_NAME="voicex-audio-outputs"
# Optional CloudFront or Custom CDN Domain (e.g., https://cdn.voicex.ai)
# AWS_S3_CUSTOM_DOMAIN="https://cdn.voicex.ai"

# Stripe Secret & Webhook Keys
STRIPE_SECRET_KEY="sk_test_51MockStripeSecretKeyForDevelopmentOnly12345"
STRIPE_WEBHOOK_SECRET="whsec_mockStripeWebhookSigningSecret12345"

# Stripe Product & Price IDs (Subscriptions)
STRIPE_PRICE_CREATOR="price_creator_monthly"
STRIPE_PRICE_PRO="price_pro_monthly"

# Stripe Product & Price IDs (One-Time Credit Packs)
STRIPE_PRICE_CREDITS_1K="price_credits_1k"
STRIPE_PRICE_CREDITS_5K="price_credits_5k"
STRIPE_PRICE_CREDITS_20K="price_credits_20k"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
